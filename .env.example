DATABASE_URL=sqlite:///./orders.db
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Which model reads the PDFs: anthropic or gemini
EXTRACTION_PROVIDER=anthropic

# Anthropic (EXTRACTION_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5

# Google Gemini (EXTRACTION_PROVIDER=gemini)
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-3.5-flash

# Copy this file to .env and put real keys there. Never commit real keys to this file.
